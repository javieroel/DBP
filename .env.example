# Copie este archivo como .env y cambie los valores. El archivo .env NUNCA se sube a Git.
PORT=3000
NODE_ENV=development

# Conexión a PostgreSQL: use DATABASE_URL (Render la entrega) o las variables DB_* de abajo
# DATABASE_URL=postgresql://incidentes_app:clave@host:5432/incidentes_db
DB_HOST=localhost
DB_PORT=5432
DB_NAME=incidentes_db
DB_USER=incidentes_app
DB_PASSWORD=cambie_esta_clave
# true solo si el servidor PostgreSQL tiene certificado TLS (p. ej. base remota)
DB_SSL=false
# true para ver en consola el SQL que genera Sequelize (útil para las capturas)
DB_LOGGING=false

# Seguridad (Unidad 6)
# Clave para firmar los tokens JWT. Genere una con: openssl rand -hex 32
JWT_SECRET=genere_una_clave_aleatoria_de_64_caracteres_con_openssl
JWT_EXPIRES_IN=1h
# Orígenes externos autorizados por CORS (separados por comas). La interfaz propia no lo necesita.
CORS_ORIGINS=http://localhost:3000
# HTTPS con Caddy (perfil "https" de docker compose):
#   HTTPS_PROXY_ENABLED=true, APP_PORT=127.0.0.1:3000 y SITE_ADDRESS=<IP o dominio del servidor>
HTTPS_PROXY_ENABLED=false
APP_PORT=3000
SITE_ADDRESS=localhost

# Contraseñas iniciales de los usuarios de prueba (seeder). Cámbielas.
SEED_ADMIN_PASSWORD=cambie_clave_admin
SEED_ANALISTA_PASSWORD=cambie_clave_analista
SEED_LECTOR_PASSWORD=cambie_clave_lector

# Operación (Unidad 8)
# Nivel mínimo de los logs: debug, info, warn o error
LOG_LEVEL=info
# true para cargar usuarios y datos de ejemplo al arrancar el contenedor (los seeders son idempotentes)
SEED_ON_START=false
