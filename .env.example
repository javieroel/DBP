# Copie este archivo como .env y cambie los valores. El archivo .env NUNCA se sube a Git.
PORT=3000
NODE_ENV=development

# Conexión a PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_NAME=incidentes_db
DB_USER=incidentes_app
DB_PASSWORD=cambie_esta_clave
# true solo si el servidor PostgreSQL tiene certificado TLS (p. ej. base remota)
DB_SSL=false
# true para ver en consola el SQL que genera Sequelize (útil para las capturas)
DB_LOGGING=false
